# 값 설명: DevDocs/07-dev-environment.md §4
# 로컬 에뮬레이터만 쓸 때는 이 두 줄이면 된다 (Firebase 설정은 demo 값으로 자동 채움)
VITE_APP_ENV=dev
VITE_USE_EMULATORS=true

# 드라이브 백엔드: memory(기본: 에뮬레이터 사용 시) | google
# VITE_DRIVE_BACKEND=google

# 실제 Firebase dev 프로젝트(jjok-20fd1)에 붙을 때: VITE_USE_EMULATORS=false 로 바꾸고 아래를 채운다
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=jjok-20fd1.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=jjok-20fd1
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=      # Google Analytics (없으면 수집 안 함)
# VITE_GOOGLE_OAUTH_CLIENT_ID=

VITE_AGENT_BASE_URL=http://localhost:8000
