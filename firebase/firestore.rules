rules_version = '2';

// 규칙 설계: DevDocs/04-security.md §2
// 사용자 데이터 컬렉션 목록을 바꾸면 DevDocs/03-data-model.md 와 tests/ 도 함께 고친다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasSchemaVersion() {
      return request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1;
    }

    // 클라이언트는 agent 가 만든 것처럼 보이는 문서를 만들 수 없다.
    function notAgentCreated() {
      return request.resource.data.get('createdBy', 'user') != 'agent';
    }

    // createdBy 는 한 번 정해지면 바꿀 수 없다 (agent 제안의 status 만 바꿀 수 있음).
    function createdByUnchanged() {
      return request.resource.data.get('createdBy', 'user') == resource.data.get('createdBy', 'user');
    }

    function isUserCollection(coll) {
      return coll in [
        'axes', 'collections', 'tags', 'annotations', 'links',
        'notes', 'templates', 'graphViews', 'notifications'
      ];
    }

    function workPath(uid, workId) {
      return /databases/$(database)/documents/users/$(uid)/works/$(workId);
    }

    // 기본 버전이 쓰기 후에 실제로 있어야 한다 (F-1.4.1). 같은 배치로 만드는 버전도 existsAfter 로 확인한다.
    function primaryVersionExists(uid, workId) {
      return request.resource.data.primaryVersionId is string
        && existsAfter(/databases/$(database)/documents/users/$(uid)/works/$(workId)/versions/$(request.resource.data.primaryVersionId));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasSchemaVersion();
      allow delete: if false; // 계정 삭제는 서버 경유

      // 사용자 데이터: 이름을 나열한 컬렉션만 허용 (하위 컬렉션 포함). works 는 아래에서 따로 다룬다
      match /{coll}/{docId=**} {
        allow read, delete: if isOwner(uid) && isUserCollection(coll);
        allow create: if isOwner(uid) && isUserCollection(coll) && hasSchemaVersion() && notAgentCreated();
        allow update: if isOwner(uid) && isUserCollection(coll) && hasSchemaVersion() && createdByUnchanged();
      }

      // 논문과 버전 (DevDocs/03-data-model.md §3.2·§3.3). 위 목록 대신 여기서 무결성을 함께 검사한다.
      match /works/{workId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && hasSchemaVersion() && notAgentCreated()
          && primaryVersionExists(uid, workId);
        allow update: if isOwner(uid) && hasSchemaVersion() && createdByUnchanged()
          && primaryVersionExists(uid, workId);

        match /versions/{versionId} {
          allow read: if isOwner(uid);
          // 논문 없이 버전만 남지 않게 한다
          allow create: if isOwner(uid) && hasSchemaVersion() && notAgentCreated()
            && existsAfter(workPath(uid, workId));
          allow update: if isOwner(uid) && hasSchemaVersion() && createdByUnchanged();
          // 기본 버전은 논문이 남아 있는 한 지울 수 없다 (먼저 기본 버전을 바꾸거나 논문과 함께 지운다)
          allow delete: if isOwner(uid)
            && (!existsAfter(workPath(uid, workId))
              || getAfter(workPath(uid, workId)).data.primaryVersionId != versionId);
        }
      }

      // 키 표시 정보(last4): 본인 읽기만, 쓰기는 서버(Admin SDK)만
      match /meta/llmKeys {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // BYOK 암호문: 클라이언트 접근 전면 금지
      match /apiKeys/{provider} {
        allow read, write: if false;
      }
    }

    // 인용 관계 공용 캐시: 로그인 사용자 읽기, 쓰기는 서버만
    match /citationCache/{paperKey} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
