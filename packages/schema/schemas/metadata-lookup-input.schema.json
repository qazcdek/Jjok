{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metadata-lookup-input.schema.json",
  "title": "MetadataLookupInput",
  "description": "내장 도구 metadata-lookup 입력: POST /v1/tools/metadata-lookup. DevDocs/05-agent-server.md §4.5. doi·arxiv·title 중 하나 이상 (서버가 검사)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "doi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "arxiv": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "버전 접미사 없이"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "식별자로 못 찾을 때 제목 검색에 쓴다"
    }
  }
}
