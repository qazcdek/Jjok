# DevDocs/07-dev-environment.md §4
APP_ENV=dev
FIREBASE_PROJECT_ID=demo-jjok
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 에뮬레이터 사용 시 (Admin SDK 가 에뮬레이터 토큰을 검증)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# LLAMA_BASE_URL=http://localhost:8080/v1
# 실제 dev 프로젝트에 붙을 때: FIREBASE_PROJECT_ID=jjok-20fd1 로 바꾸고 위 두 EMULATOR_HOST 줄을 지운다
# 메타데이터 조회(metadata-lookup)에 Semantic Scholar 를 쓰려면 (없으면 S2 를 건너뜀)
# S2_API_KEY=
